<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        tools:ignore="MissingConstraints">

        <include
            android:id="@+id/toolbar"
            layout="@layout/toolbar" />
    </LinearLayout>

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="168dp"
        android:layout_marginEnd="174dp"
        android:text="@string/txt_view"
 />


    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/hint_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginBottom="16dp"
        android:src="@android:drawable/ic_menu_add"
        app:fabSize="auto"
        app:layout_constraintBottom_toBottom0f="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.954"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/camera_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:fabSize="normal"
        app:layout_constraintBottom_toTopOf="@+id/hint_fab"
        app:layout_constraintEnd_toEndOf="@+id/hint_fab"
        app:layout_constraintStart_toStartOf="@+id/hint_fab"
        app:srcCompat="@drawable/baseline_camera_24" />

    <TextView
        android:id="@+id/camera_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text="Camera"
        app:layout_constraintBottom_toBottomOf="@+id/camera_fab"
        app:layout_constraintEnd_toStartOf="@+id/camera_fab"
        app:layout_constraintTop_toTopOf="@+id/camera_fab" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/location_fab"
        app:fabSize="normal"
        android:src="@android:drawable/ic_dialog_map"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@+id/camera_fab"
        app:layout_constraintEnd_toEndOf="@+id/camera_fab"
        app:layout_constraintStart_toStartOf="@+id/camera_fab" />

    <TextView
        android:id="@+id/location_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text="Location"
        app:layout_constraintBottom_toBottomOf="@+id/location_fab"
        app:layout_constraintEnd_toStartOf="@+id/location_fab"
        app:layout_constraintTop_toTopOf="@+id/location_fab" />
</androidx.constraintlayout.widget.ConstraintLayout>